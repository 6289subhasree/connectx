# MongoDB Atlas free tier (M0) connection string, or local mongod
MONGODB_URI=mongodb://127.0.0.1:27017/connectx
JWT_SECRET=change-this-to-a-long-random-string
PORT=5000
# Seed demo users automatically on first start (true/false)
SEED_ON_START=true
# Optional SMTP for email notifications (FR-12 / FR-17). Leave blank to log emails instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ConnectX <no-reply@connectx.app>
APP_URL=
